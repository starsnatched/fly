{
  "readout": {
    "dnHzScale": 8.0,
    "map": [
      { "channel": "throttle", "signal": "motorDrive", "gain": 1.0 },
      { "channel": "steer",    "signal": "dnSteer",    "gain": 1.0 },
      { "channel": "steer",    "signal": "flowYaw",    "gain": 0.8 },
      { "channel": "throttle", "signal": "flowPitch",  "gain": 0.35 }
    ]
  },
  "actuators": {
    "channels": [
      { "name": "throttle", "lo": 0.0, "hi": 1.0, "slewPerS": 4.0, "default": 0.3 },
      { "name": "steer", "lo": -1.0, "hi": 1.0, "slewPerS": 10.0, "default": 0.0 }
    ]
  },
  "sensors": {
    "visionHz": 120,
    "eyes": { "count": 1, "leftId": 0, "rightId": 1 },
    "touch": { "burstMv": 6.0 },
    "scalarRanges": {
      "altitude": [0.0, 1.0],
      "speed": [0.0, 4.0],
      "vy": [-2.0, 2.0],
      "clearance": [0.0, 25.0],
      "tauScale": 9.0
    }
  },
  "reward": {
    "rewardGain": 0.3
  }
}
